{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "Jellyfin.Plugin.WatchGuard.slnx",
        "--configuration",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "Jellyfin.Plugin.WatchGuard.slnx",
        "--configuration",
        "Debug"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "package",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/build-release.py"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
